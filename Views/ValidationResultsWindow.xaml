<Window x:Class="BIMModelHealthDashboard.Views.ValidationResultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Model Health – Validation Results"
        Height="760"
        Width="1300"
        MinHeight="500"
        MinWidth="900"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6FA"
        FontFamily="Segoe UI"
        FontSize="11">

    <Window.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#172B4D"/>
            <Setter Property="BorderBrush" Value="#DCE3ED"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EEF2F8"/>
            <Setter Property="BorderBrush" Value="#DCE3ED"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#FAFBFD"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
        </Style>

        <Style x:Key="WrapCell" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="4,3"/>
        </Style>

        <Style x:Key="SeverityCell" TargetType="TextBlock">
            <Setter Property="Margin" Value="4,3"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="Text" Value="Critical">
                    <Setter Property="Foreground" Value="#9B1C1C"/>
                </Trigger>
                <Trigger Property="Text" Value="High">
                    <Setter Property="Foreground" Value="#D64545"/>
                </Trigger>
                <Trigger Property="Text" Value="Medium">
                    <Setter Property="Foreground" Value="#DD6B20"/>
                </Trigger>
                <Trigger Property="Text" Value="Low">
                    <Setter Property="Foreground" Value="#61738E"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusCell" TargetType="TextBlock">
            <Setter Property="Margin" Value="4,3"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="Text" Value="Passed">
                    <Setter Property="Foreground" Value="#159447"/>
                </Trigger>
                <Trigger Property="Text" Value="Failed">
                    <Setter Property="Foreground" Value="#D64545"/>
                </Trigger>
                <Trigger Property="Text" Value="Error">
                    <Setter Property="Foreground" Value="#9B1C1C"/>
                </Trigger>
                <Trigger Property="Text" Value="Rules needed">
                    <Setter Property="Foreground" Value="#B7791F"/>
                </Trigger>
                <Trigger Property="Text" Value="Not applicable">
                    <Setter Property="Foreground" Value="#8A97AB"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock x:Name="TitleText"
                           Text="Validation Results"
                           FontSize="17"
                           FontWeight="Bold"
                           Foreground="#172B4D"/>
                <TextBlock x:Name="SummaryText"
                           Foreground="#61738E"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Bottom">
                <TextBlock Text="Group"
                           VerticalAlignment="Center"
                           Foreground="#61738E"
                           Margin="0,0,6,0"/>
                <ComboBox x:Name="GroupFilter"
                          Width="190"
                          SelectionChanged="GroupFilter_SelectionChanged"/>
                <TextBlock Text="Search"
                           VerticalAlignment="Center"
                           Foreground="#61738E"
                           Margin="14,0,6,0"/>
                <TextBox x:Name="SearchBox"
                         Width="220"
                         Padding="4,3"
                         TextChanged="SearchBox_TextChanged"/>
            </StackPanel>
        </Grid>

        <!-- CHECKS | ISSUES -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="470" MinWidth="320"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*" MinWidth="380"/>
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="ChecksGrid"
                      SelectionMode="Single"
                      SelectionChanged="ChecksGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Check" Binding="{Binding CheckName}" Width="*" ElementStyle="{StaticResource WrapCell}"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="88" ElementStyle="{StaticResource StatusCell}"/>
                    <DataGridTextColumn Header="Issues" Binding="{Binding IssueCount, StringFormat=N0}" Width="55"/>
                    <DataGridTextColumn Header="Worst" Binding="{Binding WorstSeverityText}" Width="62" ElementStyle="{StaticResource SeverityCell}"/>
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          Background="Transparent"/>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Background="White"
                        BorderBrush="#DCE3ED"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="12,10"
                        Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock x:Name="CheckTitleText"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="#172B4D"/>
                        <TextBlock x:Name="CheckDescriptionText"
                                   Foreground="#61738E"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,0"/>
                        <TextBlock x:Name="CheckSummaryText"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0"/>
                        <TextBlock x:Name="CheckWarningsText"
                                   Foreground="#B7791F"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <DataGrid x:Name="IssuesGrid"
                          Grid.Row="1"
                          SelectionMode="Extended"
                          MouseDoubleClick="IssuesGrid_MouseDoubleClick"
                          SelectionChanged="IssuesGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Severity" Binding="{Binding SeverityText}" Width="70" ElementStyle="{StaticResource SeverityCell}"/>
                        <DataGridTextColumn Header="Element" Binding="{Binding ElementName}" Width="2*" ElementStyle="{StaticResource WrapCell}"/>
                        <DataGridTextColumn Header="Issue" Binding="{Binding Message}" Width="3*" ElementStyle="{StaticResource WrapCell}"/>
                        <DataGridTextColumn Header="Element IDs" Binding="{Binding ElementIdsText}" Width="120" ElementStyle="{StaticResource WrapCell}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>

        <!-- FOOTER -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="FooterText"
                       VerticalAlignment="Center"
                       Foreground="#61738E"
                       Text="Double-click an issue to select and zoom to it in Revit."/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="SelectButton"
                        Content="Select in Revit"
                        Style="{StaticResource ActionButtonStyle}"
                        Click="SelectInRevit_Click"/>
                <Button Content="Select All for Check"
                        Style="{StaticResource ActionButtonStyle}"
                        Click="SelectAllForCheck_Click"/>
                <Button Content="Export Report"
                        Style="{StaticResource ActionButtonStyle}"
                        Click="Export_Click"/>
                <Button Content="Close"
                        Style="{StaticResource ActionButtonStyle}"
                        Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
