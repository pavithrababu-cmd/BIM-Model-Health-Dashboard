<Window x:Class="BIMModelHealthDashboard.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BIM Model Health Dashboard"
        Height="900"
        Width="1500"
        MinHeight="700"
        MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6FA"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="MetricCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DCE3ED"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DCE3ED"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <Style x:Key="MetricLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#61738E"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="MetricValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="27"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#172B4D"/>
            <Setter Property="Margin" Value="0,8,0,2"/>
        </Style>

        <Style x:Key="SectionHeadingStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#172B4D"/>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#172B4D"/>
            <Setter Property="BorderBrush" Value="#DCE3ED"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#2864E8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2864E8"/>
        </Style>

        <!-- One requirement line inside a checker card -->
        <DataTemplate x:Key="CheckRowTemplate">
            <Border Background="Transparent"
                    Cursor="Hand"
                    Padding="0,3"
                    ToolTip="{Binding ToolTip}"
                    MouseLeftButtonUp="CheckRow_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding Bullet}"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"/>

                    <TextBlock Grid.Column="1"
                               Text="{Binding ResultText}"
                               Foreground="{Binding ResultBrush}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Margin="12,0,0,0"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- One health indicator: label, then a large value coloured by status -->
        <DataTemplate x:Key="IndicatorRowTemplate">
            <StackPanel Margin="0,0,0,12"
                        Background="Transparent"
                        ToolTip="{Binding Tip}">
                <TextBlock Text="{Binding Label}"
                           FontSize="12"
                           Foreground="#172B4D"/>
                <TextBlock Text="{Binding Value}"
                           Foreground="{Binding StatusBrush}"
                           FontSize="22"
                           FontWeight="Bold"
                           Margin="0,2,0,0"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="38"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#E0E6EF"
                BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="■"
                               Foreground="#E9AB00"
                               FontSize="15"
                               Margin="0,0,10,0"/>

                    <TextBlock Text="BIM MODEL HEALTH"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="#172B4D"/>

                    <TextBlock Text="  |  Revit 2025"
                               FontSize="11"
                               Foreground="#61738E"
                               VerticalAlignment="Center"/>
                </StackPanel>

            </Grid>
        </Border>

        <!-- ACTIVE MODEL -->
        <Border Grid.Row="1"
                Margin="16,8,16,12"
                Background="White"
                BorderBrush="#DCE3ED"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="ACTIVE MODEL"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="#61738E"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0"/>

                    <TextBlock x:Name="ModelFileNameText"
                               Text="Active Revit project"
                               FontSize="11"
                               Foreground="#172B4D"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="HEALTH SCORE"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="#61738E"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>

                    <TextBlock x:Name="HealthScoreText"
                               Text="--"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#172B4D"
                               VerticalAlignment="Center"/>

                    <TextBlock x:Name="HealthStatusText"
                               Text="Checks not yet run"
                               FontSize="11"
                               Foreground="#61738E"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN DASHBOARD -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel Margin="16,0,16,14">

                <!-- FOUR TOP METRIC CARDS -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- FILE SIZE -->
                    <Border Grid.Column="0"
                            Style="{StaticResource MetricCardStyle}"
                            BorderThickness="1,4,1,1"
                            BorderBrush="#E9AB00">
                        <StackPanel>
                            <TextBlock Text="FILE SIZE"
                                       Style="{StaticResource MetricLabelStyle}"/>

                            <TextBlock x:Name="FileSizeText"
                                       Text="N/A"
                                       Style="{StaticResource MetricValueStyle}"
                                       Foreground="#159447"/>

                            <TextBlock Text="Saved project file"
                                       FontSize="10"
                                       Foreground="#61738E"/>
                        </StackPanel>
                    </Border>

                    <!-- TOTAL FAMILIES -->
                    <Border Grid.Column="1"
                            Style="{StaticResource MetricCardStyle}"
                            BorderThickness="1,4,1,1"
                            BorderBrush="#3478F6">
                        <StackPanel>
                            <TextBlock Text="TOTAL FAMILIES"
                                       Style="{StaticResource MetricLabelStyle}"/>

                            <TextBlock x:Name="TotalFamiliesText"
                                       Text="0"
                                       Style="{StaticResource MetricValueStyle}"/>

                            <TextBlock Text="Loaded family definitions"
                                       FontSize="10"
                                       Foreground="#61738E"/>
                        </StackPanel>
                    </Border>

                    <!-- REVIT WARNINGS -->
                    <Border Grid.Column="2"
                            Style="{StaticResource MetricCardStyle}"
                            BorderThickness="1,4,1,1"
                            BorderBrush="#F04444">
                        <StackPanel>
                            <TextBlock Text="REVIT WARNINGS"
                                       Style="{StaticResource MetricLabelStyle}"/>

                            <TextBlock x:Name="WarningsText"
                                       Text="0"
                                       Style="{StaticResource MetricValueStyle}"/>

                            <TextBlock Text="Native Revit warnings"
                                       FontSize="10"
                                       Foreground="#61738E"/>
                        </StackPanel>
                    </Border>

                    <!-- TOTAL ISSUES -->
                    <Border Grid.Column="3"
                            Style="{StaticResource MetricCardStyle}"
                            Margin="0"
                            BorderThickness="1,4,1,1"
                            BorderBrush="#13A552">
                        <StackPanel>
                            <TextBlock Text="TOTAL ISSUES"
                                       Style="{StaticResource MetricLabelStyle}"/>

                            <TextBlock x:Name="TotalIssuesText"
                                       Text="--"
                                       Style="{StaticResource MetricValueStyle}"/>

                            <TextBlock x:Name="TotalIssuesSubText"
                                       Text="Awaiting validation scan"
                                       FontSize="10"
                                       Foreground="#61738E"/>
                        </StackPanel>
                    </Border>
                </Grid>


                <!-- PROJECT READINESS / MODEL ORGANIZATION / DEPENDENCIES -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <ContentControl HorizontalAlignment="Left" Margin="0,0,0,8">
                                <Canvas Width="22" Height="22">
                                    <Rectangle Canvas.Left="4" Canvas.Top="4" Width="14" Height="17" RadiusX="2.5" RadiusY="2.5" Stroke="#2864E8" StrokeThickness="2"/>
                                    <Rectangle Canvas.Left="8" Canvas.Top="1.5" Width="6" Height="4.5" RadiusX="1.2" RadiusY="1.2" Fill="White" Stroke="#2864E8" StrokeThickness="2"/>
                                    <Path Data="M7.5,13 L10,15.5 L14.5,10.5" Stroke="#2864E8" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Canvas>
                            </ContentControl>

                            <TextBlock Text="PROJECT READINESS"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="#172B4D"/>

                            <Separator Margin="0,10,0,12"/>

                            <ItemsControl x:Name="ReadinessList"
                                          ItemTemplate="{StaticResource IndicatorRowTemplate}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1"
                            Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <ContentControl HorizontalAlignment="Left" Margin="0,0,0,8">
                                <Canvas Width="22" Height="22">
                                    <Path Data="M4,6.5 Q4,4 11,4 Q18,4 18,6.5 Q18,9 11,9 Q4,9 4,6.5 Z" Stroke="#159447" StrokeThickness="2" StrokeLineJoin="Round"/>
                                    <Path Data="M3,12 L19,12" Stroke="#159447" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Path Data="M4,16 Q11,19.5 18,16" Stroke="#159447" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>
                            </ContentControl>

                            <TextBlock Text="MODEL ORGANIZATION"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="#172B4D"/>

                            <Separator Margin="0,10,0,12"/>

                            <ItemsControl x:Name="OrganizationList"
                                          ItemTemplate="{StaticResource IndicatorRowTemplate}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Style="{StaticResource SectionCardStyle}"
                            Margin="0">
                        <StackPanel>
                            <ContentControl HorizontalAlignment="Left" Margin="0,0,0,8">
                                <Canvas Width="22" Height="22">
                                    <Path Data="M11,6 L11,11 M6,15 L6,11 L16,11 L16,15" Stroke="#B7791F" StrokeThickness="2" StrokeLineJoin="Round"/>
                                    <Ellipse Canvas.Left="8" Canvas.Top="1" Width="6" Height="6" Fill="White" Stroke="#B7791F" StrokeThickness="2"/>
                                    <Ellipse Canvas.Left="3" Canvas.Top="15" Width="6" Height="6" Fill="White" Stroke="#B7791F" StrokeThickness="2"/>
                                    <Ellipse Canvas.Left="13" Canvas.Top="15" Width="6" Height="6" Fill="White" Stroke="#B7791F" StrokeThickness="2"/>
                                </Canvas>
                            </ContentControl>

                            <TextBlock Text="DEPENDENCIES"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="#172B4D"/>

                            <Separator Margin="0,10,0,12"/>

                            <ItemsControl x:Name="DependenciesList"
                                          ItemTemplate="{StaticResource IndicatorRowTemplate}"/>
                        </StackPanel>
                    </Border>

                </Grid>


                <!-- MODEL MANAGEMENT ACTIONS -->
                <TextBlock Text="MODEL MANAGEMENT ACTIONS"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="#172B4D"
                           Margin="0,0,0,10"/>

                <!-- ELEMENT AND WALL CHECKERS -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Style="{StaticResource SectionCardStyle}"
                            MinHeight="180">
                        <StackPanel>
                            <TextBlock Text="01 | ELEMENT CHECKER"
                                       Style="{StaticResource SectionHeadingStyle}"/>
                            <TextBlock Text="Element parameters, family types and duplicate validation"
                                       FontSize="10"
                                       Foreground="#61738E"
                                       Margin="0,7,0,12"/>
                            <Separator Margin="0,0,0,9"/>
                            <ItemsControl x:Name="ElementChecksList"
                                          ItemTemplate="{StaticResource CheckRowTemplate}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1"
                            Style="{StaticResource SectionCardStyle}"
                            Margin="0"
                            MinHeight="180">
                        <StackPanel>
                            <TextBlock Text="02 | WALL CHECKER"
                                       Style="{StaticResource SectionHeadingStyle}"/>
                            <TextBlock Text="Wall connectivity, warnings and coordination"
                                       FontSize="10"
                                       Foreground="#61738E"
                                       Margin="0,7,0,12"/>
                            <Separator Margin="0,0,0,9"/>
                            <ItemsControl x:Name="WallChecksList"
                                          ItemTemplate="{StaticResource CheckRowTemplate}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ROOM AND STANDARDS CHECKERS -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Style="{StaticResource SectionCardStyle}"
                            MinHeight="180">
                        <StackPanel>
                            <TextBlock Text="03 | ROOM CHECKER"
                                       Style="{StaticResource SectionHeadingStyle}"/>
                            <TextBlock Text="Room placement, enclosure, views and levels"
                                       FontSize="10"
                                       Foreground="#61738E"
                                       Margin="0,7,0,12"/>
                            <Separator Margin="0,0,0,9"/>
                            <ItemsControl x:Name="RoomChecksList"
                                          ItemTemplate="{StaticResource CheckRowTemplate}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1"
                            Style="{StaticResource SectionCardStyle}"
                            Margin="0"
                            MinHeight="180">
                        <StackPanel>
                            <TextBlock Text="04 | STANDARDS &amp; COMPLIANCE"
                                       Style="{StaticResource SectionHeadingStyle}"/>
                            <TextBlock Text="Company standards and model data compliance"
                                       FontSize="10"
                                       Foreground="#61738E"
                                       Margin="0,7,0,12"/>
                            <Separator Margin="0,0,0,9"/>
                            <ItemsControl x:Name="StandardsChecksList"
                                          ItemTemplate="{StaticResource CheckRowTemplate}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock Text="Hover over a health indicator to see why it matters and its target. Click any check line to see its issues; double-click an issue to select it in Revit. Fix All Issues repairs what can be fixed automatically. Export Report creates a PDF with the before/after health analysis."
                           FontSize="10"
                           Foreground="#61738E"
                           Margin="2,5,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- BOTTOM STATUS BAR -->
        <Border Grid.Row="3"
                Background="White"
                BorderBrush="#DCE3ED"
                BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="ScanStatusText"
                           Text="Ready to refresh model metrics."
                           FontSize="10"
                           Foreground="#61738E"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                     <Button Content="Run Full Scan"
                            Click="RunModelScan_Click"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="0,2,8,2"
                            MinWidth="120"/>

                    <Button Content="Fix All Issues"
                            Click="FixAllIssues_Click"
                            Style="{StaticResource ActionButtonStyle}"
                            Background="#FDF1DC"
                            BorderBrush="#E9AB00"
                            Margin="0,2,8,2"
                            MinWidth="115"
                            ToolTip="Automatically fix the issues that can be fixed safely (one Revit undo step)"/>

                    <Button Content="All Results"
                            Click="ViewAllResults_Click"
                            Style="{StaticResource ActionButtonStyle}"
                            Margin="0,2,8,2"
                            MinWidth="95"/>

                    <Button Content="Export Report"
                            Click="Report_Click"
                            Style="{StaticResource ActionButtonStyle}"
                            Margin="0,2"
                            MinWidth="105"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
